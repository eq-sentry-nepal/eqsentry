{
  "name": "eqsentry-server",
  "version": "1.0.0",
  "description": "EQ Sentry backend — USGS proxy/cache, alert subscriptions (double opt-in), and an automated earthquake alert engine for Nepal.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/server.test.mjs",
    "alerts:once": "node lib/alertEngine.js --once",
    "dev": "node --watch server.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "cors": "^2.8.5",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nodemailer": "^9.0.6",
    "web-push": "^3.6.7"
  }
}
