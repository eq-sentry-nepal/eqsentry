<?xml version="1.0" encoding="UTF-8"?>
<!-- Sitemap index. Kept at /sitemap.xml so robots.txt and anything already
     submitted to Search Console keep working — submit this one URL and Google
     reads all three children, then reports coverage for each separately.

     NOTE: <changefreq> and <priority> are deliberately absent. Google has
     stated it ignores both; they were only ever noise. <lastmod> is the one
     field that actually influences recrawl scheduling, and build.mjs injects
     it per-URL from each file's last commit date. -->
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap><loc>https://www.eqsentry.com/sitemap-core.xml</loc></sitemap>
  <sitemap><loc>https://www.eqsentry.com/sitemap-safety.xml</loc></sitemap>
  <sitemap><loc>https://www.eqsentry.com/sitemap-data.xml</loc></sitemap>
</sitemapindex>
